# Required configuration
# Base URL where your data directory is served (used for feed enclosure URLs)
BASE_URL=https://example.com/feeds

# Path to the data directory containing your content files
DATA_DIR=./data

# OpenAI-compatible API endpoint for LLM summarization
LLM_ENDPOINT=https://llm.example.com/v1

# API key for your LLM endpoint
LLM_API_KEY=your-llm-api-key-here

# Model identifier to use for LLM summarization
LLM_MODEL=your-model-name

# System prompt for LLM summarization
LLM_SYSTEM_PROMPT="Summarize key takeaways from this document. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking."

# System prompt for regular summarization (replaces LLM_SYSTEM_PROMPT for summarization)
SUMMARY_PROMPT="Summarize key takeaways from this document. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output just the summary concisely in a few paragraph."

# System prompt for summarization when reflection.md is present (optional)
# If not set, falls back to SUMMARY_PROMPT
SUMMARY_REFLECTION_PROMPT="Summarize key takeaways from this document. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output just the summary concisely in paragraph format with minimal punctuation. Consider the following reflection questions to focus the summary- "

# System prompt for LLM title generation
TITLE_PROMPT="Generate a concise, descriptive title (5-10 words) for the given content. The title should capture the main topic or theme. Do not include any formatting, quotes, or extra text — just the title."

# Feed format: rss or atom (default: rss)
FEED_FORMAT=rss

# Whisper model size for transcription: tiny, base, small, medium, large-v3 (default: large-v3-turbo)
TRANSCRIPTION_MODEL=large-v3-turbo

# Device for transcription: cuda (recommended) or cpu (default: cuda)
TRANSCRIPTION_DEVICE=cuda

# Compute type for transcription: float16 (best quality) or int8 (lower memory) (default: float16)
TRANSCRIPTION_COMPUTE_TYPE=float16
