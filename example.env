# Required configuration
# Base URL where your data directory is served (used for feed enclosure URLs)
BASE_URL=https://example.com/feeds

# Path to the data directory containing your content files
DATA_DIR=./data

# OpenAI-compatible API endpoint for LLM summarization
LLM_ENDPOINT=https://llm.example.com/v1

# API key for your LLM endpoint
LLM_API_KEY=your-llm-api-key-here

# Model identifier to use for LLM summarization
LLM_MODEL=your-model-name

PROMPT_ARTICLE="Summarize key takeaways from this document. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output just the summary concisely in a few paragraph."
PROMPT_ARTICLE_REFLECTION="Summarize key takeaways from this document. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output a list of frameworks and tools, and for each of the applicable reflection questions, output approx one paragraph answering it based on the article. Focus on the following reflection questions-"

PROMPT_PODCAST="Summarize key takeaways from this podcast transcript. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output just the summary concisely in a few paragraph."
PROMPT_PODCAST_REFLECTION="Summarize key takeaways from this podcast transcript. Focus on frameworks or analytical tools to develop critical, creative, and systems thinking. Output just the summary concisely in a few paragraphs, and for each of the applicable reflection questions, output approx one paragraph answering it based on the transcript. Focus on the following reflection questions-"

PROMPT_TITLE="Generate a concise, descriptive title (5-10 words) for the given content. Use the extracted title as is if available and relevant. Consider the filename. Otherwise capture the main topic or theme. Do not include any formatting, quotes, or extra text - just the title."

# Whisper model size for transcription: tiny, base, small, medium, large-v3 (default: large-v3-turbo)
TRANSCRIPTION_MODEL=large-v3-turbo

# Device for transcription: cuda (recommended) or cpu (default: cuda)
TRANSCRIPTION_DEVICE=cuda

# Compute type for transcription: float16 (best quality) or int8 (lower memory) (default: float16)
TRANSCRIPTION_COMPUTE_TYPE=float16
